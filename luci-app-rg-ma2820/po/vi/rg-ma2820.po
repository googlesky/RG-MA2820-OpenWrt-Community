msgstr "Đã kết nối %s · rỗi %s"

msgid "Actions"
msgstr "Thao tác"

msgid "Steer"
msgstr "Điều hướng"

msgid "Disconnect"
msgstr "Ngắt kết nối"

msgid "Disconnect this client from the current BSS?"
msgstr "Ngắt thiết bị này khỏi BSS hiện tại?"

msgid "No clients are associated."
msgstr "Không có thiết bị nào đang kết nối."

msgid "Recent roaming events"
msgstr "Sự kiện chuyển vùng gần đây"

msgid "No steering events have been recorded."
msgstr "Chưa ghi nhận sự kiện điều hướng nào."

