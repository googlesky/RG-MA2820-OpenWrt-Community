msgid "RG-MA2820 Wi-Fi & Roaming"
msgstr "Wi-Fi & chuyển vùng RG-MA2820"

msgid "RG-MA2820 Wi-Fi & wired roaming"
msgstr "Wi-Fi & chuyển vùng có dây RG-MA2820"

msgid "Wi-Fi and wired roaming configuration"
msgstr "Cấu hình Wi-Fi và chuyển vùng có dây"

msgid "2.4 GHz"
msgstr "2.4 GHz"

msgid "5 GHz"
msgstr "5 GHz"

msgid "This page drives the Broadcom vendor stack directly because these radios are not managed by mac80211/netifd. Save & Apply validates the entire profile before either AP is changed."
msgstr "Trang này điều khiển trực tiếp bộ phần mềm Broadcom vì các radio không được mac80211/netifd quản lý. Lưu & Áp dụng sẽ kiểm tra toàn bộ hồ sơ trước khi thay đổi bất kỳ AP nào."

msgid "Ethernet is the backhaul. 802.11k/v and optional 802.11r help compatible clients move between the two BSS sets; the client always decides when to roam."
msgstr "Ethernet là đường truyền backhaul. 802.11k/v và 802.11r tùy chọn giúp thiết bị tương thích di chuyển giữa hai tập BSS; thiết bị khách luôn là bên quyết định thời điểm chuyển vùng."

msgid "General"
msgstr "Tổng quát"

msgid "Roaming & mesh"
msgstr "Chuyển vùng & mesh"

msgid "Driver advanced"
msgstr "Driver nâng cao"

msgid "Apply target"
msgstr "Đích áp dụng"

msgid "Pair mode updates the peer first over pinned-key SSH, then this AP. Manual channels require local mode so the APs are not assigned the same channel."
msgstr "Chế độ cặp cập nhật AP ngang hàng trước qua SSH có khóa được ghim, sau đó mới đến AP này. Kênh thủ công yêu cầu chế độ cục bộ để hai AP không bị gán cùng kênh."

msgid "Both wired APs (recommended)"
msgstr "Cả hai AP có dây (khuyên dùng)"

msgid "This AP only"
msgstr "Chỉ AP này"

msgid "Driver country profile"
msgstr "Hồ sơ quốc gia của driver"

msgid "The current “#a” Broadcom pseudo-domain exposes the largest driver channel set. Changing this also changes channel and power constraints."
msgstr "Miền giả Broadcom “#a” hiện tại mở tập kênh lớn nhất của driver. Thay đổi mục này cũng thay đổi các giới hạn kênh và công suất."

msgid "#a — Broadcom all-channel profile"
msgstr "#a — hồ sơ mọi kênh Broadcom"

msgid "Beacon interval"
msgstr "Khoảng beacon"

msgid "Time units; 100 is the compatibility default."
msgstr "Đơn vị thời gian beacon; 100 là mặc định tương thích."

msgid "DTIM period"
msgstr "Chu kỳ DTIM"

msgid "Lower values wake power-saving clients more often."
msgstr "Giá trị thấp hơn đánh thức thiết bị tiết kiệm điện thường xuyên hơn."

msgid "Enable 2.4 GHz radio"
msgstr "Bật radio 2.4 GHz"

msgid "Enable 5 GHz radio"
msgstr "Bật radio 5 GHz"

msgid "SSID"
msgstr "SSID"

msgid "Primary SSID"
msgstr "SSID chính"

msgid "Security mode"
msgstr "Chế độ bảo mật"

msgid "Primary security"
msgstr "Bảo mật mạng chính"

msgid "Open"
msgstr "Mở"

msgid "Open (no encryption)"
msgstr "Mở (không mã hóa)"

msgid "WPA2-PSK (CCMP)"
msgstr "WPA2-PSK (CCMP)"

msgid "WPA2-PSK / CCMP"
msgstr "WPA2-PSK / CCMP"

msgid "WPA3-SAE"
msgstr "WPA3-SAE"

msgid "WPA2/WPA3 transition"
msgstr "Chuyển tiếp WPA2/WPA3"

msgid "New passphrase"
msgstr "Mật khẩu mới"

msgid "New primary passphrase"
msgstr "Mật khẩu mạng chính mới"

msgid "Leave empty to keep the current secret."
msgstr "Để trống để giữ mật khẩu hiện tại."

msgid "Management frame protection"
msgstr "Bảo vệ khung quản lý"

msgid "Primary management frame protection"
msgstr "Bảo vệ khung quản lý của mạng chính"

msgid "Disabled"
msgstr "Tắt"

msgid "Optional"
msgstr "Tùy chọn"

msgid "Required"
msgstr "Bắt buộc"

msgid "MFP optional"
msgstr "MFP tùy chọn"

msgid "MFP required"
msgstr "MFP bắt buộc"

msgid "802.11r fast transition"
msgstr "Chuyển tiếp nhanh 802.11r"

msgid "Primary 802.11r fast transition"
msgstr "Chuyển tiếp nhanh 802.11r của mạng chính"

msgid "Disabled by default for IoT and camera compatibility."
msgstr "Mặc định tắt để tương thích với thiết bị IoT và camera."

msgid "Hide SSID"
msgstr "Ẩn SSID"

msgid "Hide primary SSID"
msgstr "Ẩn SSID chính"

msgid "Client isolation"
msgstr "Cách ly thiết bị khách"

msgid "Primary client isolation"
msgstr "Cách ly thiết bị mạng chính"

msgid "Maximum clients"
msgstr "Số thiết bị tối đa"

msgid "Primary maximum clients"
msgstr "Số thiết bị tối đa của mạng chính"

msgid "Channel"
msgstr "Kênh"

msgid "Automatic"
msgstr "Tự động"

msgid "Automatic (peer-aware 1/6/11)"
msgstr "Tự động (phối hợp peer trên 1/6/11)"

msgid "Automatic (peer-aware non-DFS blocks)"
msgstr "Tự động (phối hợp peer trên các khối không DFS)"

msgid "Transmit power (dBm)"
msgstr "Công suất phát (dBm)"

msgid "Wi-Fi 6 (802.11ax)"
msgstr "Wi-Fi 6 (802.11ax)"

msgid "HE BSS color"
msgstr "Màu BSS HE"

msgid "Driver selected"
msgstr "Driver tự chọn"

msgid "Enable compatibility BSS"
msgstr "Bật BSS tương thích"

msgid "A second 5 GHz BSS for clients that need WPA2."
msgstr "Một BSS 5 GHz thứ hai cho thiết bị cần WPA2."

msgid "Compatibility SSID"
msgstr "SSID tương thích"

msgid "Compatibility security"
msgstr "Bảo mật mạng tương thích"

msgid "New compatibility passphrase"
msgstr "Mật khẩu mạng tương thích mới"

msgid "Compatibility management frame protection"
msgstr "Bảo vệ khung quản lý của mạng tương thích"

msgid "Compatibility 802.11r fast transition"
msgstr "Chuyển tiếp nhanh 802.11r của mạng tương thích"

msgid "Hide compatibility SSID"
msgstr "Ẩn SSID tương thích"

msgid "Compatibility client isolation"
msgstr "Cách ly thiết bị mạng tương thích"

msgid "Compatibility maximum clients"
msgstr "Số thiết bị tối đa của mạng tương thích"

msgid "Channel width"
msgstr "Độ rộng kênh"

msgid "%d MHz"
msgstr "%d MHz"

msgid "802.11k neighbor reports"
msgstr "Báo cáo AP lân cận 802.11k"

msgid "802.11v BSS transition"
msgstr "Chuyển BSS 802.11v"

msgid "802.11r mobility domain"
msgstr "Miền di động 802.11r"

msgid "Exactly four hexadecimal digits, shared by both APs."
msgstr "Đúng bốn chữ số thập lục phân, dùng chung cho cả hai AP."

msgid "Enter exactly four hexadecimal digits."
msgstr "Nhập đúng bốn chữ số thập lục phân."

msgid "802.11r over the distribution system"
msgstr "802.11r qua hệ thống phân phối"

msgid "Disabled uses over-the-air FT, which has broader client interoperability."
msgstr "Khi tắt sẽ dùng FT qua sóng, tương thích với nhiều thiết bị khách hơn."

msgid "Active RSSI steering"
msgstr "Điều hướng chủ động theo RSSI"

msgid "Clients still make the final roaming decision; this controller sends standards-based 802.11v requests."
msgstr "Thiết bị khách vẫn quyết định chuyển vùng; bộ điều khiển này gửi yêu cầu 802.11v theo chuẩn."

msgid "Steer 2.4 GHz clients"
msgstr "Điều hướng thiết bị 2.4 GHz"

msgid "Keep disabled for conservative IoT/camera behavior."
msgstr "Nên tắt để giữ tương thích ổn định với IoT/camera."

msgid "Steer 5 GHz clients"
msgstr "Điều hướng thiết bị 5 GHz"

msgid "Sampling interval (seconds)"
msgstr "Chu kỳ lấy mẫu (giây)"

msgid "Soft steering threshold (dBm)"
msgstr "Ngưỡng điều hướng mềm (dBm)"

msgid "Consecutive weak samples"
msgstr "Số mẫu yếu liên tiếp"

msgid "Steering cooldown (seconds)"
msgstr "Thời gian nghỉ điều hướng (giây)"

msgid "Minimum association age (seconds)"
msgstr "Thời gian kết nối tối thiểu (giây)"

msgid "Hard fallback for persistently weak clients"
msgstr "Ngắt cưỡng bức dự phòng cho thiết bị yếu kéo dài"

msgid "Hard fallback threshold (dBm)"
msgstr "Ngưỡng ngắt cưỡng bức (dBm)"

msgid "Hard fallback delay (seconds)"
msgstr "Độ trễ ngắt cưỡng bức (giây)"

msgid "Hard fallback window (seconds)"
msgstr "Cửa sổ ngắt cưỡng bức (giây)"

msgid "Airtime fairness (TAF)"
msgstr "Công bằng thời lượng sóng (TAF)"

msgid "Broadcom transmit airtime scheduler."
msgstr "Bộ lập lịch thời lượng phát của Broadcom."

msgid "Frame bursting"
msgstr "Phát khung liên tiếp"

msgid "Reduce contention overhead; may reduce fairness with neighboring networks."
msgstr "Giảm chi phí tranh chấp; có thể giảm tính công bằng với mạng lân cận."

msgid "Explicit beamforming"
msgstr "Beamforming tường minh"

msgid "Use client feedback to steer transmitted energy."
msgstr "Dùng phản hồi của thiết bị để định hướng năng lượng phát."

msgid "Implicit beamforming"
msgstr "Beamforming ngầm định"

msgid "Estimate steering without explicit client feedback."
msgstr "Ước lượng hướng phát không cần phản hồi tường minh từ thiết bị."

msgid "Multi-user scheduling"
msgstr "Lập lịch đa người dùng"

msgid "Enable driver MU-MIMO/OFDMA scheduling support."
msgstr "Bật hỗ trợ lập lịch MU-MIMO/OFDMA của driver."

msgid "A-MPDU aggregation"
msgstr "Gộp A-MPDU"

msgid "Aggregate MPDUs for higher throughput."
msgstr "Gộp các MPDU để tăng thông lượng."

msgid "A-MSDU aggregation"
msgstr "Gộp A-MSDU"

msgid "Aggregate MSDUs for lower protocol overhead."
msgstr "Gộp các MSDU để giảm chi phí giao thức."

msgid "LDPC coding"
msgstr "Mã hóa LDPC"

msgid "Forward-error correction used by modern PHY modes."
msgstr "Sửa lỗi xuôi được các chế độ PHY hiện đại sử dụng."

msgid "Transmit STBC"
msgstr "STBC phát"

msgid "Space-time block coding for transmit diversity."
msgstr "Mã khối không gian-thời gian để đa dạng hóa đường phát."

msgid "Receive STBC"
msgstr "STBC thu"

msgid "Advertise receive space-time block coding."
msgstr "Quảng bá khả năng thu mã khối không gian-thời gian."

msgid "Guard interval policy"
msgstr "Chính sách khoảng bảo vệ"

msgid "Long / HE 1.6 µs"
msgstr "Dài / HE 1,6 µs"

msgid "Short / HE 0.8 µs"
msgstr "Ngắn / HE 0,8 µs"

msgid "Short, 1×LTF / HE 0.8 µs"
msgstr "Ngắn, 1×LTF / HE 0,8 µs"

msgid "Short, 2×LTF / HE 0.8 µs"
msgstr "Ngắn, 2×LTF / HE 0,8 µs"

msgid "Short, 2×LTF / HE 1.6 µs"
msgstr "Ngắn, 2×LTF / HE 1,6 µs"

msgid "Short, 4×LTF / HE 3.2 µs"
msgstr "Ngắn, 4×LTF / HE 3,2 µs"

msgid "MAC access policy"
msgstr "Chính sách truy cập MAC"

msgid "Deny listed clients"
msgstr "Từ chối thiết bị trong danh sách"

msgid "Allow only listed clients"
msgstr "Chỉ cho phép thiết bị trong danh sách"

msgid "MAC address list"
msgstr "Danh sách địa chỉ MAC"

msgid "Comma- or space-separated; applies to every enabled BSS."
msgstr "Phân cách bằng dấu phẩy hoặc khoảng trắng; áp dụng cho mọi BSS đang bật."

msgid "Enter comma- or space-separated MAC addresses."
msgstr "Nhập các địa chỉ MAC phân cách bằng dấu phẩy hoặc khoảng trắng."

msgid "Use 1–32 printable ASCII characters; apostrophes are not supported."
msgstr "Dùng 1–32 ký tự ASCII in được; không hỗ trợ dấu nháy đơn."

msgid "Use 8–63 printable ASCII characters without apostrophes or leading/trailing spaces."
msgstr "Dùng 8–63 ký tự ASCII in được, không có dấu nháy đơn hay khoảng trắng ở đầu/cuối."

msgid "Enter a passphrase because this WLAN does not have an existing secret."
msgstr "Hãy nhập mật khẩu vì WLAN này chưa có mật khẩu hiện hữu."

msgid "At least one radio must remain enabled."
msgstr "Phải giữ ít nhất một radio được bật."

msgid "Pair mode requires automatic channels; use local mode for a manual channel plan."
msgstr "Chế độ cặp yêu cầu kênh tự động; hãy dùng chế độ cục bộ để đặt kế hoạch kênh thủ công."

msgid "The selected channel is not valid at this 5 GHz width."
msgstr "Kênh đã chọn không hợp lệ với độ rộng 5 GHz này."

msgid "The hard threshold must be lower than the soft steering threshold."
msgstr "Ngưỡng cưỡng bức phải thấp hơn ngưỡng điều hướng mềm."

msgid "The hard fallback window must be longer than its delay."
msgstr "Cửa sổ ngắt cưỡng bức phải dài hơn độ trễ của nó."

msgid "Enter “auto” or a value from 1 to 31 dBm."
msgstr "Nhập “auto” hoặc giá trị từ 1 đến 31 dBm."

msgid "Enter “auto” or a BSS color from 1 to 63."
msgstr "Nhập “auto” hoặc màu BSS từ 1 đến 63."

msgid "READY"
msgstr "SẴN SÀNG"

msgid "DEGRADED"
msgstr "SUY GIẢM"

