msgstr "thử nghiệm %s"

msgid "pending %s"
msgstr "đang chờ %s"

msgid "%s · firmware %s · %s · wired roaming %s · peer %s %s · channels local %s/%s, peer %s/%s"
msgstr "%s · firmware %s · %s · chuyển vùng có dây %s · peer %s %s · kênh cục bộ %s/%s, peer %s/%s"

msgid "The wired peer is offline."
msgstr "AP ngang hàng có dây đang ngoại tuyến."

msgid "Immutable recovery is active. Wi-Fi settings are read-only and vendor radios are intentionally unavailable."
msgstr "Đang chạy recovery bất biến. Cấu hình Wi-Fi chỉ được đọc và các radio của hãng được chủ động vô hiệu hóa."

msgid "The two APs do not have the same mesh configuration."
msgstr "Hai AP không có cùng cấu hình mesh."

msgid "The AP channel plan overlaps or has not converged yet."
msgstr "Kế hoạch kênh của hai AP đang chồng lấn hoặc chưa hội tụ."

msgid "A configured radio or BSS is offline."
msgstr "Một radio hoặc BSS đã cấu hình đang ngoại tuyến."

msgid "A radio did not apply the configured transmit-power policy."
msgstr "Một radio chưa áp dụng đúng chính sách công suất phát đã cấu hình."

msgid "The browser timezone is unavailable or is not supported by this firmware."
msgstr "Không đọc được múi giờ trình duyệt hoặc firmware này chưa hỗ trợ múi giờ đó."

msgid "Timezone update failed"
msgstr "Cập nhật múi giờ thất bại"

msgid "Timezone synchronized to %s on both APs."
msgstr "Đã đồng bộ múi giờ %s cho cả hai AP."

msgid "Automatic timezone detection is disabled on both APs."
msgstr "Đã tắt tự động nhận diện múi giờ trên cả hai AP."

msgid "Unable to update timezone: %s"
msgstr "Không thể cập nhật múi giờ: %s"

msgid "Geographic timezone"
msgstr "Múi giờ theo vị trí địa lý"

msgid "%s configured · browser reports %s"
msgstr "Đang cấu hình %s · trình duyệt báo %s"

msgid "Synchronize now"
msgstr "Đồng bộ ngay"

msgid "Detection uses the browser IANA timezone once, validates it against the local database, then synchronizes both wired APs without contacting an external geolocation service."
msgstr "Hệ thống lấy múi giờ IANA từ trình duyệt một lần, kiểm tra bằng cơ sở dữ liệu cục bộ rồi đồng bộ cả hai AP có dây mà không liên hệ dịch vụ định vị bên ngoài."

msgid "Automatic timezone synchronization failed: %s"
msgstr "Tự động đồng bộ múi giờ thất bại: %s"

msgid "The selected 5 GHz channel requires DFS/radar handling."
msgstr "Kênh 5 GHz đã chọn yêu cầu xử lý DFS/radar."

msgid "The saved settings use the legacy schema and will be upgraded on the next apply."
msgstr "Cấu hình đã lưu dùng schema cũ và sẽ được nâng cấp ở lần áp dụng kế tiếp."

