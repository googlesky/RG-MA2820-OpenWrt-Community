msgstr "%d dBm / SNR %d dB"

msgid "%s · k=%s · v=%s"
msgstr "%s · k=%s · v=%s"

msgid "Detected driver capabilities"
msgstr "Khả năng driver đã phát hiện"

msgid "Driver capability detection failed."
msgstr "Không thể phát hiện khả năng của driver."

msgid "%s · %s · 2×2 spatial streams · vendor nl80211 integration (not mac80211/netifd)"
msgstr "%s · %s · 2×2 luồng không gian · tích hợp nl80211 của hãng (không phải mac80211/netifd)"

msgid "Hardware"
