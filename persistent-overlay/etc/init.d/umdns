#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# OpenWrt umdns service adapted for the retained RGOS 4.1.52 kernel.

START=80

USE_PROCD=1
PROG=/usr/sbin/umdns

load_ifaces()
{
	local network="$(uci -q get umdns.@umdns[-1].network)"
	for n in $network; do
		local device
		json_load "$(ifstatus "$n")"
		json_get_var device l3_device
		echo -n "$device "
	done
}

do_reload_service()
{
	json_init
	json_add_array interfaces
	for i in $(load_ifaces); do
		json_add_string "" "$i"
	done
	json_close_array
	ubus call umdns set_config "$(json_dump)"
}

start_service()
{
	local network="$(uci -q get umdns.@umdns[-1].network)"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn

	procd_open_data
	json_add_array firewall
	for n in $network; do
		json_add_object ""
		json_add_string type rule
		json_add_string proto udp
		json_add_string src "$n"
		json_add_int dest_port 5353
		json_add_string target ACCEPT
		json_close_object
	done
	json_close_array
	procd_close_data

	procd_open_trigger
	procd_add_config_trigger "config.change" "umdns" /etc/init.d/umdns reload
	for n in $network; do
		procd_add_interface_trigger "interface.*" "$n" /etc/init.d/umdns reload
	done
	procd_add_raw_trigger "instance.update" 5000 /bin/ubus call umdns reload
	procd_close_trigger

	# Both direct execution and ubus work on this AP.  Only procd's generated
	# seccomp/jail wrapper exits on the old vendor kernel, so deliberately run
	# this small daemon without those two incompatible wrappers.
	procd_close_instance
}

reload_service()
{
	rc_procd start_service
	do_reload_service
}

service_running()
{
	ubus -t 10 wait_for umdns
	[ $? = 0 ] && do_reload_service
}
