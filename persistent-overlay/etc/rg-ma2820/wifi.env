# Generated copies replace every @...@ token during packaging.  This file is
# the immutable, recovery-friendly profile.  The owner profile is written to
# the OpenWrt overlay by rg-ma2820-set-wifi and disappears after firstboot.
WIFI_CONFIG_VERSION='3'
WIFI_PROFILE='factory'
SSID_BASE='@ROAM_SSID@'
SSID_HEX='@ROAM_SSID_HEX@'
WIFI_SECURITY='@WIFI_SECURITY@'
WPA_PSK='@WPA_PSK@'
# Packaging selects the driver country profile explicitly. The factory profile
# uses fixed, non-overlapping channels. The operational wired-roaming profile
# scans at startup and coordinates with the wired peer.
COUNTRY_CODE='@COUNTRY_CODE@'
ROAMING='1'
MOBILITY_DOMAIN='4d41'
CHANNEL_2G='@CHANNEL_2G@'
CHANNEL_5G='@CHANNEL_5G@'
WIDTH_5G='80'
TXPOWER_2G_DBM='auto'
TXPOWER_5G_DBM='auto'
# Active roaming is used only by the wired-mesh owner profile.  These safe
# defaults stay inert in the open factory profile restored by firstboot.
ENABLE_FT_SAE='1'
ROAM_STEERING='1'
ROAM_INTERVAL='4'
ROAM_RSSI_TRIGGER='-72'
ROAM_RSSI_HARD='-82'
ROAM_RSSI_SAMPLES='3'
ROAM_COOLDOWN='60'
ROAM_MIN_ASSOC_AGE='15'
ROAM_HARD_FALLBACK='1'
ROAM_HARD_DELAY='12'
ROAM_HARD_WINDOW='45'
CENTER_CHANNEL_5G='@CENTER_CHANNEL_5G@'
PEER_BSSID_2G='@PEER_BSSID_2G@'
PEER_BSSID_5G='@PEER_BSSID_5G@'
PEER_CHANNEL_2G='@PEER_CHANNEL_2G@'
PEER_CHANNEL_5G='@PEER_CHANNEL_5G@'
PEER_CENTER_CHANNEL_5G='@PEER_CENTER_CHANNEL_5G@'
PEER_OP_CLASS_5G='@PEER_OP_CLASS_5G@'
